{
	"name": "@firefoxic/stylelint-gamut",
	"version": "0.1.0-next.1",
	"description": "Stylelint plugin for working with different color spaces",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"lint-staged": {
		"*.ts": "oxlint --fix"
	},
	"files": [
		"dist/**"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/stylelint-gamut.git"
	},
	"bugs": {
		"url": "https://github.com/firefoxic/stylelint-gamut/issues"
	},
	"homepage": "https://github.com/firefoxic/stylelint-gamut#readme",
	"peerDependencies": {
		"stylelint": "^18.0.0-next.0"
	},
	"dependencies": {
		"colorjs.io": "^0.7.1"
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.5",
		"@morev/stylelint-testing-library": "^1",
		"@types/node": "^26",
		"lint-staged": "^17",
		"oxlint": "^1",
		"postcss": "^8",
		"stylelint": "^18.0.0-next.0",
		"tsrs": "^0.20.1-ts7",
		"vitest": "^5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.13",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.16",
			"onFail": "download"
		}
	},
	"scripts": {
		"help": "make help",
		"prepare": "git config --local core.hooksPath .githooks || true"
	},
	"keywords": [
		"stylelint",
		"stylelint-plugin",
		"gamut",
		"lch",
		"oklch",
		"lab",
		"oklab"
	]
}
