{
	"name": "@firefoxic/stylelint-gamut",
	"version": "0.0.1",
	"description": "Stylelint plugin for working with different color spaces",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"type": "module",
	"main": "src/index.js",
	"lint-staged": {
		"*.js": "eslint --fix",
		".": "prettier -write"
	},
	"files": [
		"src/**/*.js",
		"!**/**/*.test.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/stylelint-gamut.git"
	},
	"bugs": {
		"url": "https://github.com/firefoxic/stylelint-gamut/issues"
	},
	"homepage": "https://github.com/firefoxic/stylelint-gamut#readme",
	"peerDependencies": {
		"stylelint": "^17.0.0"
	},
	"dependencies": {
		"colorjs.io": "^0.6.1"
	},
	"devDependencies": {
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^18.0.1",
		"eslint-plugin-promise": "^7.3.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-cli": "^30.4.2",
		"jest-preset-stylelint": "^9.1.0",
		"lint-staged": "^17.0.3",
		"prettier": "^3.8.3",
		"stylelint": "^17.11.0"
	},
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --fix *.js",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"prepare": "husky install"
	},
	"keywords": [
		"stylelint",
		"stylelint-plugin",
		"gamut",
		"lch",
		"oklch",
		"lab",
		"oklab"
	]
}
