{
	"name": "@firefoxic/stylelint-gamut",
	"version": "0.0.1",
	"description": "Stylelint plugin for working with different color spaces",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"type": "module",
	"main": "src/index.js",
	"lint-staged": {
		"*.js": "oxlint --fix"
	},
	"files": [
		"src/**/*.js",
		"!**/**/*.test.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/stylelint-gamut.git"
	},
	"bugs": {
		"url": "https://github.com/firefoxic/stylelint-gamut/issues"
	},
	"homepage": "https://github.com/firefoxic/stylelint-gamut#readme",
	"peerDependencies": {
		"stylelint": "^17.0.0"
	},
	"dependencies": {
		"colorjs.io": "^0.6.1"
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.5",
		"jest": "^30.4.2",
		"jest-cli": "^30.4.2",
		"jest-preset-stylelint": "^9.1.0",
		"lint-staged": "^17.0.3",
		"oxlint": "^1",
		"stylelint": "^17.11.0"
	},
	"scripts": {
		"lint": "oxlint",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"prepare": "git config --local core.hooksPath .githooks || true"
	},
	"keywords": [
		"stylelint",
		"stylelint-plugin",
		"gamut",
		"lch",
		"oklch",
		"lab",
		"oklab"
	]
}
